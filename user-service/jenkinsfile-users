pipeline {
    agent {
        label 'worker'
    }

    tools {
        jdk 'jdk'
        maven 'mvn'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/avi-devopshub/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build') {
            steps {
                dir('user-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('user-service') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit testResults: 'user-service/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('user-service') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
		
		stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('sonar') {
            dir('user-service') {
                sh '''
                    mvn clean verify \
                      org.sonarsource.scanner.maven:sonar-maven-plugin:5.3.0.6276:sonar \
                      -Dsonar.projectKey=mederp-user
                '''
            }
        }
    }
}
	stage('quality-gate'){
		steps{
			timeout(time: 5, unit: 'MINUTES'){
				waitForQualityGate abortPipeline: true
			}
		}
	}
	


stage('OWASP Dependency Check') {
    steps {
        dir('user-service') {
            sh 'mkdir -p dependency-check-report'

            dependencyCheck(
                odcInstallation: 'owasp',
                nvdCredentialsId: 'NVD_API_KEY',
                additionalArguments: '--scan . --format XML --format HTML --out dependency-check-report'
            )
        }
    }
    post {
        always {
            dependencyCheckPublisher(
                pattern: 'user-service/dependency-check-report/dependency-check-report.xml',
                stopBuild: false,
                skipNoReportFiles: false
            )

            archiveArtifacts(
                artifacts: 'user-service/dependency-check-report/**',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }
    }
}

	
    }

    post {
        success {
            echo 'Build, unit tests, and packaging completed successfully.'
			archiveArtifacts artifacts: 'user-service/target/*.jar',  fingerprint: true
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
	
	
}
