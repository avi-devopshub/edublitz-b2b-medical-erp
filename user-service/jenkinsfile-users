pipeline{
	agent{
		label 'worker'
	}
	tools{
		jdk 'jdk'
		mvn 'mvn'	
	}
	stages{
		stage('git-checkout'){
			steps{
			git branch: 'dev', url: 'https://github.com/avi-devopshub/edublitz-b2b-medical-erp.git'
			}
		}
		stage('maven-build'){
			steps{
			dir('user-service'){
			sh 'mvn clean package'
			}
			}
		}
	}
}
