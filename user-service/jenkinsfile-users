pipeline {
    agent {
        label 'worker'
    }
	environment{
		REPO_URL = '554663574879.dkr.ecr.ap-south-1.amazonaws.com/user-service'
		AWS_CRED = credentials('aws_cred')
	}

    tools {
        jdk 'jdk'
        maven 'mvn'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/avi-devopshub/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build') {
            steps {
                dir('user-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('user-service') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit testResults: 'user-service/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('user-service') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
		
		stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('sonar') {
            dir('user-service') {
                sh '''
                    mvn clean verify \
                      org.sonarsource.scanner.maven:sonar-maven-plugin:5.3.0.6276:sonar \
                      -Dsonar.projectKey=mederp-user
                '''
            }
        }
    }
}
	stage('quality-gate'){
		steps{
			timeout(time: 5, unit: 'MINUTES'){
				waitForQualityGate abortPipeline: true
			}
		}
	}
	




	stage('docker-build'){
		steps{
			dir('user-service'){
				sh '''
				docker build -t ${REPO_URL}/user-service:${BUILD_NUMBER} .
				'''
			}
		}
	}
	
		
	stage('pust-to-ecr'){
		
		steps{
			
			sh '''
			    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 554663574879.dkr.ecr.ap-south-1.amazonaws.com
				docker push ${REPO_URL}/user-service:${BUILD_NUMBER}
			'''
		}
	}

	
	
    }

    post {
        success {
            echo 'Build, unit tests, and packaging completed successfully.'
			archiveArtifacts artifacts: 'user-service/target/*.jar',  fingerprint: true
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
	
	
}
