pipeline {

    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        aws_cred = credentials('aws-cred')
        ecr_repo = '554663574879.dkr.ecr.ap-south-1.amazonaws.com/order-service'
    }

    stages {

        stage('Git-checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/avi-devopshub/edublitz-b2b-medical-erp.git'

                echo "code-checkout completed"
            }
        }

        stage('Maven-build') {
            steps {
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true
                }
            }
        }

        stage('OWASP Dependency Check'){
            steps{
                dir('order-service'){
                    withCredentials([
                        string(
                            credentialsId: 'NVD_API_KEY',
                            variable: 'NVD_API_KEY'
                         )
                     ]) {
                         sh '''
                             mvn org.owasp:dependency-check-maven:check \
                             -DnvdApiKeyEnvironmentVariable=NVD_API_KEY
                         '''
                    }
                }
            }
        }

        stage('Sonarqube-analysis') {
            steps {
                dir('order-service') {
                    withSonarQubeEnv('sonar'){
                    sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                    }
                }
            }
        }

        stage('Sonarqube-quality-gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy Filesystem Scan'){
            steps{
				dir('order-service'){
                sh '''
                   trivy fs --scanners vuln,secret --severity HIGH,CRITICAL --exit-code 0 .
                '''
				}
            }
        }

        stage('Artifacts-to-s3') {
            steps {
                dir('order-service') {
                    sh '''
                        aws s3 cp target/*.jar s3://avidevops.fun/order-service/order.jar
                    '''
                }
            }
        }

        stage('Docker-build') {
            steps {
                dir('order-service') {
                    sh '''
                        docker build -t order-service:latest .
                    '''
                }
            }
        }

        stage('Trivy-docker-image-scan') {
            steps {
                 sh '''
                    mkdir -p "$WORKSPACE/.trivy-cache"
                    mkdir -p "$WORKSPACE/.trivy-tmp"

                    export TMPDIR="$WORKSPACE/.trivy-tmp"

                     trivy image \
                        --cache-dir "$WORKSPACE/.trivy-cache" \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        order-service:latest
                    '''
            }
        }

        stage('image-push-to-ecr') {
            steps {
                sh '''
                    aws ecr get-login-password \
                    --region ap-south-1 | \
                    docker login \
                    --username AWS \
                    --password-stdin 554663574879.dkr.ecr.ap-south-1.amazonaws.com

                    docker tag order-service:latest \
                    ${ecr_repo}:${BUILD_NUMBER}

                    docker push ${ecr_repo}:${BUILD_NUMBER}
                '''
            }
        }
    }
}