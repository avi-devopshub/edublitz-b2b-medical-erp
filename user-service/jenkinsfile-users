pipeline {
    agent {
        label 'worker'
    }

    tools {
        jdk 'jdk'
        maven 'mvn'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/avi-devopshub/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build') {
            steps {
                dir('user-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('user-service') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit testResults: 'user-service/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('user-service') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
		
		stage('sonarqube-analysis'){
		steps{
			withSonarQubeEnv('sonar'){
				dir('user-service'){
					sh '''
						mvn sonar:sonar
					'''
					
				}
			}
			
		}
		
	}
	stage('quality-gate'){
		steps{
			timeout(time: 5, unit: 'MINUTES'){
				waitForQualityGate abortPipeline: true
			}
		}
	}
    }

    post {
        success {
            echo 'Build, unit tests, and packaging completed successfully.'
			archiveArtifacts artifacts: 'user-service/target/*.jar',  fingerprint: true
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
	
	
}
