pipeline {
    agent {
        label 'worker'
    }
	environment{
		REPO_URL = '554663574879.dkr.ecr.ap-south-1.amazonaws.com/user-service'
		AWS_CRED = credentials('aws_cred')
	}

    tools {
        jdk 'jdk'
        maven 'mvn'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/avi-devopshub/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build') {
            steps {
                dir('user-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }


	stage('docker-build'){
		steps{
			dir('user-service'){
				sh '''
				docker build -t ${REPO_URL}:${BUILD_NUMBER} .
				'''
			}
		}
	}
	
		
	stage('pust-to-ecr'){
		
		steps{
			
			sh '''
			    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 554663574879.dkr.ecr.ap-south-1.amazonaws.com
				docker push ${REPO_URL}:${BUILD_NUMBER}
			'''
		}
	}

	
	
    }
	
	
}
